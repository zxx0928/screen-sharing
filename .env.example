# Copy these into the environment, or into a gitignored .env that you load yourself.
# Phase 1 reads process env directly. This repo does not load .env for you.
# Real TURN usernames and passwords stay out of git. Leave the examples empty.

# Signaling bind address.
# 127.0.0.1 — this computer only (the default).
# 0.0.0.0 — every interface, so another computer can connect. Then open the port.
SIGNALING_HOST=127.0.0.1
SIGNALING_PORT=8787

# URL the Electron client dials. Must be reachable from that computer.
# Do not use 0.0.0.0 here. For a peer on another network, use the signaling
# machine's public or LAN address, for example ws://203.0.113.10:8787.
SIGNALING_URL=ws://127.0.0.1:8787

# STUN servers, comma-separated. Unset uses stun:stun.l.google.com:19302.
# Set to none to disable STUN.
STUN_URLS=

# TURN (coturn or equivalent), comma-separated. Empty means no TURN:
# same-machine and most LAN sessions still work. See docs/network.md.
# turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# all (default) gathers host, server-reflexive, and relay candidates.
# relay forces TURN. Use it to prove the media path is the relay, not the LAN.
ICE_TRANSPORT_POLICY=all
