# Copy to .env only if you add a loader later. Phase 1 reads process env directly.
# No secrets belong in this repo. Do not put TURN credentials here.

# Signaling bind address. Keep the default unless another machine must connect.
SIGNALING_HOST=127.0.0.1
SIGNALING_PORT=8787

# URL the Electron client uses. Must be reachable from the desktop app.
SIGNALING_URL=ws://127.0.0.1:8787
